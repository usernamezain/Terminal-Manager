{
  "name": "terminal-manager",
  "version": "0.1.0",
  "description": "Desktop Terminal Manager - Phase 1 Foundation",
  "main": "dist/main/index.js",
  "scripts": {
    "docs:generate": "npx tsx scripts/docs-generate.ts",
    "docs:check": "npx tsx scripts/docs-check.ts",
    "predev": "npm run docs:generate",
    "prebuild": "npm run docs:generate",
    "dev": "node scripts/dev.mjs",
    "start": "npx electron .",
    "build": "npx tsc && npx vite build --config vite.main.config.ts && npx vite build --config vite.preload.config.ts && npx vite build --config vite.renderer.config.ts",
    "perf": "node scripts/measurePerf.mjs",
    "perf:bench": "npx tsx scripts/perf-bench.ts",
    "perf:check": "npx tsx scripts/perf-check.ts",
    "verify": "npm run docs:check && npx tsc --noEmit && npx vitest run && npm run perf:check",
    "rebuild": "npx electron-rebuild -f -w node-pty",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "npx electron-rebuild -f -w node-pty || node -e \"console.log('Skipping node-pty rebuild (Visual Studio C++ build tools not found). Using installed binary.')\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "marked": "^18.1.1",
    "minisearch": "^7.2.0",
    "node-pty": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.terminalmanager.app",
    "productName": "Terminal Manager",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json",
      "resources/**/*",
      "!**/*.map",
      "!**/__tests__/**",
      "!**/*.test.*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist-release"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "uninstallDisplayName": "Terminal Manager",
      "deleteAppDataOnUninstall": false
    }
  }
}

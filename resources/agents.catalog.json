    {
      "id": "claude",
      "name": "Claude Code",
      "vendor": "Anthropic",
      "description": "Agentic coding CLI tool that lives in your terminal and helps you code faster",
      "command": "claude",
      "versionArgs": ["--version"],
      "installMethods": [
        {
          "id": "powershell-native",
          "label": "Native Installer (PowerShell)",
          "shell": "powershell",
          "command": "irm https://claude.ai/install.ps1 | iex",
          "requires": ["git"],
          "isScriptPipe": true,
          "source": "claude.ai",
          "recommended": true
        },
        {
          "id": "cmd-native",
          "label": "Native Installer (Command Prompt)",
          "shell": "cmd",
          "command": "curl -fsSL https://claude.ai/install.cmd -o install.cmd && install.cmd && del install.cmd",
          "requires": [],
          "isScriptPipe": true,
          "source": "claude.ai",
          "recommended": false
        },
        {
          "id": "winget",
          "label": "WinGet",
          "shell": "powershell",
          "command": "winget install Anthropic.ClaudeCode",
          "requires": ["winget"],
          "isScriptPipe": false,
          "source": "microsoft.com",
          "recommended": false
        },
        {
          "id": "npm",
          "label": "npm (Global)",
          "shell": "powershell",
          "command": "npm install -g @anthropic-ai/claude-code",
          "requires": ["node", "npm"],
          "isScriptPipe": false,
          "source": "npmjs.com",
          "recommended": false
        }
      ],
      "updateCommand": "claude update",
      "uninstallHint": "Run 'npm uninstall -g @anthropic-ai/claude-code' or remove ~/.local/bin/claude",
      "signIn": {
        "type": "browser",
        "instructions": "Sign in with a paid Claude account (Pro/Team) or an Anthropic Console API key",
        "command": "claude auth login"
      },
      "cost": {
        "note": "Requires paid Claude Pro/Team plan or Anthropic Console API credits",
        "verifiedOn": "2026-10-13"
      },
      "docsUrl": "https://docs.anthropic.com/en/docs/agents-and-tools/claude-code",
      "status": "active",
      "windows": "native",
      "resumeArgs": ["--resume"],
      "knownInstallDirs": ["%USERPROFILE%\\.local\\bin"]
    },
